generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id                    String   @id @default(uuid())
  city                  String   @unique
  country               String?
  continent             String?
  description           String?
  heroImage             String?
  galleryImages         String[]
  coordinates           Json?
  timezone              String?
  averageBudgetPerDay   Float?
  luxuryBudgetPerDay    Float?
  recommendedTripDays   Int?
  climate               String?
  bestSeason            String?
  tags                  String[]
  popularityScore       Int?
  famousFor             String[]
  transportationOptions String[]
  safetyScore           Int?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  places                Place[]
  activities            Activity[]
}

model Place {
  id              String   @id @default(uuid())
  name            String
  city            String
  country         String?
  cityRef         City     @relation(fields: [city], references: [city], onDelete: Cascade)
  description     String?
  images          String[]
  openingHours    String?
  estimatedCost   Float?
  durationHours   Float?
  category        String?
  rating          Float?
  coordinates     Json?
  bestTimeToVisit String?
  tips            String[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  itineraryItems  ItineraryPlace[]
}

model Activity {
  id              String   @id @default(uuid())
  title           String
  city            String
  country         String?
  cityRef         City     @relation(fields: [city], references: [city], onDelete: Cascade)
  category        String?
  durationHours   Float?
  estimatedPrice  Float?
  images          String[]
  description     String?
  rating          Float?
  suitableFor     String[]
  difficultyLevel String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  itineraryItems  ItineraryActivity[]
}

model Trip {
  id              String   @id @default(uuid())
  tripName        String
  totalDuration   Int?
  travelersCount  Int      @default(1)
  tripImages      String[]
  userId          String   @default("mock-user-123")
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  destinations    TripDestination[]
  itinerary       ItineraryDay[]
  budgetSummary   BudgetSummary?
  packingChecklist ChecklistItem[]
  notes           Note[]
}

model TripDestination {
  id       String @id @default(uuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city     String
  duration Int
}

model BudgetSummary {
  id             String @id @default(uuid())
  tripId         String @unique
  trip           Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  totalEstimated Float  @default(0)
  accommodation  Float  @default(0)
  food           Float  @default(0)
  transport      Float  @default(0)
  activities     Float  @default(0)
}

model ItineraryDay {
  id         String @id @default(uuid())
  day        Int
  city       String
  tripId     String
  trip       Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  places     ItineraryPlace[]
  activities ItineraryActivity[]
}

model ItineraryPlace {
  id             String       @id @default(uuid())
  itineraryDayId String
  placeId        String
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  place          Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model ItineraryActivity {
  id             String       @id @default(uuid())
  itineraryDayId String
  activityId     String
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  activity       Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id      String  @id @default(uuid())
  item    String
  packed  Boolean @default(false)
  tripId  String
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Note {
  id      String   @id @default(uuid())
  title   String?
  content String?
  date    DateTime @default(now())
  tripId  String
  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
