generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id                String    @id @default(uuid())
  fullName          String
  username          String    @unique
  email             String    @unique
  password          String
  avatar            String?
  role              Role      @default(user)
  bio               String?
  travelPreferences Json?
  savedDestinations String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  trips             Trip[]
  journals          Journal[]
}

model Trip {
  id              String    @id @default(uuid())
  title           String
  description     String?
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  coverImage      String?
  startDate       DateTime?
  endDate         DateTime?
  estimatedBudget Float?
  travelersCount  Int       @default(1)
  visibility      String    @default("private") // "private" or "public"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  budget          Budget?
  packingList     PackingChecklist[]
  journals        Journal[]
}

model Destination {
  id              String    @id @default(uuid())
  city            String    @unique
  country         String
  description     String?
  heroImage       String?
  averageBudget   Float?
  recommendedDays Int?
  climate         String?
  bestSeason      String?
  tags            String[]
  popularityScore Int       @default(0)

  famousPlaces    FamousPlace[]
  activities      Activity[]
}

model FamousPlace {
  id            String      @id @default(uuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  category      String?
  image         String?
  estimatedCost Float?
  durationHours Float?
  rating        Float?
}

model Activity {
  id              String      @id @default(uuid())
  destinationId   String
  destination     Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  title           String
  category        String?
  estimatedPrice  Float?
  durationHours   Float?
  description     String?
  image           String?
  rating          Float?
}

model Budget {
  id                String @id @default(uuid())
  tripId            String @unique
  trip              Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  accommodationCost Float  @default(0)
  transportCost     Float  @default(0)
  foodCost          Float  @default(0)
  activityCost      Float  @default(0)
  miscellaneousCost Float  @default(0)
  totalCost         Float  @default(0)
}

model PackingChecklist {
  id       String  @id @default(uuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category String?
  itemName String
  isPacked Boolean @default(false)
}

model Journal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String
  content   String
  images    String[]
  createdAt DateTime @default(now())
}
